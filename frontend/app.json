{
  "expo": {
    "name": "Prohori",
    "slug": "frontend",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "frontend",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.emergent.rulesdemotoolkit.ffaezq",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Record fraud complaints by voice in Bangla",
        "NSPhotoLibraryUsageDescription": "Upload transaction screenshots to auto-fill complaints"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#000000"
      },
      "package": "com.emergent.rulesdemotoolkit.ffaezq",
      "permissions": ["android.permission.RECORD_AUDIO", "android.permission.READ_MEDIA_IMAGES"]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-image.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#000000"
        }
      ],
      "expo-font",
      "expo-image",
      "expo-secure-store",
      "expo-web-browser",
      "expo-status-bar",
      ["expo-audio", { "microphonePermission": "Record fraud complaints by voice in Bangla" }],
      ["expo-image-picker", { "photosPermission": "Upload transaction screenshots to auto-fill complaints" }],
      "@react-native-vector-icons/ionicons"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
